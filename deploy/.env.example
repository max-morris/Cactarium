# Copy to deploy/.env and fill in. deploy/.env is never committed.

# The database password (any long random string; `just setup` generates one).
POSTGRES_PASSWORD=

# The public origin. Locally: http://localhost:8000.
CACTARIUM_BASE_URL=https://cactarium.cct.lsu.edu

# Who is always superadmin, comma-separated: github:<numeric account id> (`gh api users/<login> -q .id`;
# never the login, which can be renamed and claimed by someone else), orcid:<iD>, or dev:<name>.
CACTARIUM_SUPERADMIN=github:40468543

# OAuth apps. GitHub: Settings > Developer settings > OAuth Apps, callback <base>/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ORCID: Developer tools, redirect URI <base>/auth/orcid/callback. Sandbox: https://sandbox.orcid.org
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_BASE_URL=https://orcid.org

# Behind the host's Apache: read the client address from X-Forwarded-For.
CACTARIUM_TRUST_PROXY=1

# Where the app is published on the host (loopback only).
BIND=127.0.0.1
PORT=8000

# Seconds between polls of every tracked repo (default 4 hours).
#CACTARIUM_POLL_SECONDS=14400
